{
  "version": 1,
  "description": "Genre mapping for free-text metadata (Homebrew desc/name) and structured store genres (iTunes, LS UTI). First matching text rule wins. Edit $data_dir/rules/category_mapping.v1.json to update without recompiling.",
  "text_rules": [
    {
      "id": "browser-phrases",
      "any": [
        "web browser",
        "internet browser",
        "browser with",
        "chromium-based browser"
      ],
      "category": "Browsing",
      "level": "neutral"
    },
    {
      "id": "browser-generic",
      "any": ["browser"],
      "none": ["file browser", "browse files"],
      "category": "Browsing",
      "level": "neutral"
    },
    {
      "id": "development",
      "any": [
        "code editor",
        "ide ",
        " ide",
        "terminal emulator",
        "coding agent",
        "coding assistant",
        "software development",
        "version control",
        "docker",
        "kubernetes",
        "api development",
        "git client"
      ],
      "category": "Development",
      "level": "productive"
    },
    {
      "id": "ai-coding",
      "all": ["ai", "code"],
      "category": "Development",
      "level": "productive"
    },
    {
      "id": "communication-collaboration",
      "any": [
        "teamwork",
        "collaboration",
        "collaborative",
        "team chat",
        "team messenger",
        "team communication",
        "instant messaging",
        "enterprise messaging",
        "workplace messaging",
        "office messenger",
        "group chat",
        "video conferencing",
        "video conference",
        "conference call",
        "meeting client",
        "email client",
        "mail client"
      ],
      "category": "Communication",
      "level": "productive"
    },
    {
      "id": "messaging-generic",
      "any": ["messaging"],
      "none": ["message queue"],
      "category": "Communication",
      "level": "productive"
    },
    {
      "id": "chat-generic",
      "any": ["chat"],
      "none": ["chatbot", "chatgpt"],
      "category": "Communication",
      "level": "productive"
    },
    {
      "id": "remote-access-tools",
      "any": [
        "remote desktop",
        "remote-access",
        "remote access",
        "remote control",
        "remote-control",
        "remote admin",
        "screen sharing",
        "screen share",
        "vnc client",
        "vnc server",
        "rdp client",
        "rdp server",
        "desktop sharing",
        "unattended access",
        "unattended remote"
      ],
      "none": [
        "remote work",
        "remote team",
        "remote collaboration",
        "work remotely",
        "customer support",
        "tech support",
        "support ticket",
        "support chat"
      ],
      "category": "Utilities",
      "level": "neutral"
    },
    {
      "id": "security-auth",
      "any": [
        "password manager",
        "2fa",
        "authenticator",
        "password vault"
      ],
      "category": "Utilities",
      "level": "neutral"
    },
    {
      "id": "writing-notes",
      "any": [
        "note-taking",
        "notes app",
        "markdown editor",
        "knowledge base",
        "wiki"
      ],
      "category": "Writing",
      "level": "productive"
    },
    {
      "id": "entertainment-media",
      "any": [
        "video player",
        "music player",
        "media player",
        "streaming media",
        "streaming video"
      ],
      "category": "Entertainment",
      "level": "distracting"
    },
    {
      "id": "social",
      "any": [
        "social network",
        "social media",
        "social networking"
      ],
      "category": "Social",
      "level": "distracting"
    },
    {
      "id": "utilities-network",
      "any": [
        "vpn",
        "proxy client",
        "firewall",
        "system monitor",
        "network accelerator",
        "game booster",
        "download manager",
        "file transfer",
        "disk utility",
        "backup utility"
      ],
      "category": "Utilities",
      "level": "neutral"
    },
    {
      "id": "productivity-office",
      "any": [
        "spreadsheet",
        "word processor",
        "office suite",
        "presentation",
        "project management",
        "task manager",
        "todo app",
        "to-do",
        "calendar app",
        "crm "
      ],
      "category": "Productivity",
      "level": "productive"
    },
    {
      "id": "creative",
      "any": [
        "vector graphics",
        "photo editor",
        "image editor",
        "3d modeling",
        "video editor"
      ],
      "category": "Creative",
      "level": "productive"
    },
    {
      "id": "ai-assistant",
      "any": [
        "ai assistant",
        "chatbot",
        "large language",
        "llm"
      ],
      "category": "Productivity",
      "level": "productive"
    }
  ],
